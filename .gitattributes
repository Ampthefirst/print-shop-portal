# Normalise to LF in the repository. Without this, shell scripts authored on
# Windows are committed with CRLF and fail on Render's Linux builder with
# "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

*.exe   binary
*.png   binary
*.jpg   binary
*.stl   binary
