# Copy to .env for local development. Never commit .env itself.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres, local and hosted alike. Neon hands you this string on the project
# dashboard. Use a dedicated Neon branch for development so you are never
# developing against live client data.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Configured in later phases; the app runs without them ------------------

# Phase 2 - Resend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Phase 5 - Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Phase 10 - Google Calendar
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Phase 11 - Stripe
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
